<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Aura Stremio Addons</title>
<style>
body{font-family:system-ui,sans-serif;max-width:560px;margin:3rem auto;padding:0 1rem;background:#111;color:#eee}
.card{background:#1c1c1c;border-radius:12px;padding:1rem 1.25rem;margin:1rem 0}
a.btn{display:inline-block;background:#7b5bf5;color:#fff;padding:.5rem 1rem;border-radius:8px;text-decoration:none}
code{font-size:.8rem;word-break:break-all;color:#aaa}
</style></head><body>
<h1>Aura Stremio Addons</h1>
<div id="list"></div>
<script>
const addons=[["Aura Sportea","sportea"],["Aura Schedule","schedule"]];
const host=location.host;
document.getElementById('list').innerHTML=addons.map(([n,k])=>`
<div class="card"><h3>${n}</h3>
<a class="btn" href="stremio://${host}/${k}/manifest.json">Install</a>
<p><code>https://${host}/${k}/manifest.json</code></p></div>`).join('');
</script></body></html>
